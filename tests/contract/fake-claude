#!/bin/sh
# Stand-in for claude as claude-code's reader asks it a setup-token
# account's windows (src/readers/claude_code.rs, `question`):
#   CLAUDE_CODE_OAUTH_TOKEN=<token> CLAUDE_CONFIG_DIR=<empty dir> \
#   claude -p --model haiku --output-format stream-json --verbose --tools '' \
#     --strict-mcp-config --no-session-persistence --setting-sources '' \
#     --system-prompt 'Answer with one word.' quota
# It answers the stream Claude Code 2.1.326 answered on afkconvoy's host
# (recorded/claude-code-question.jsonl), its rate_limit_event's
# unifiedWindows the account's windows, exit 0 (truefit.toml, standin
# "claude-code"). With no CLAUDE_CODE_OAUTH_TOKEN, or FAKE_CLAUDE_FAULT=refused,
# it answers as Claude Code 2.1.331 does a token refused (HTTP 401), exit 1.
#
# FAKE_CLAUDE_BODY: a file whose stream it answers instead.
# FAKE_CLAUDE_LOG: a file each call appends to: its arguments on one line,
#   then `token <its CLAUDE_CODE_OAUTH_TOKEN>`, then `config empty` or
#   `config not empty` (CLAUDE_CONFIG_DIR as given) and whether it ran in it.
if [ -n "$FAKE_CLAUDE_LOG" ]; then
    {
        echo "$*"
        echo "token ${CLAUDE_CODE_OAUTH_TOKEN:-none}"
        if [ -d "$CLAUDE_CONFIG_DIR" ] && [ -z "$(ls -A "$CLAUDE_CONFIG_DIR")" ]; then
            state=empty
        else
            state="not empty"
        fi
        [ "$(pwd -P)" = "$(cd "$CLAUDE_CONFIG_DIR" 2>/dev/null && pwd -P)" ] && where="run in it" || where="run elsewhere"
        echo "config $state, $where"
    } >>"$FAKE_CLAUDE_LOG"
fi
if [ -z "$CLAUDE_CODE_OAUTH_TOKEN" ] || [ "$FAKE_CLAUDE_FAULT" = refused ]; then
    cat <<'JSON'
{"type":"system","subtype":"init","cwd":"/tmp","session_id":"00000000-0000-0000-0000-000000000001","tools":[],"mcp_servers":[],"model":"claude-haiku-5-5","permissionMode":"default","apiKeySource":"none"}
{"type":"assistant","message":{"id":"msg_0001","model":"<synthetic>","role":"assistant","type":"message","content":[{"type":"text","text":"Failed to authenticate. API Error: 401 OAuth access token is invalid."}]},"parent_tool_use_id":null,"session_id":"00000000-0000-0000-0000-000000000001","error":"authentication_failed"}
{"type":"result","subtype":"success","is_error":true,"api_error_status":401,"duration_ms":2100,"num_turns":1,"result":"Failed to authenticate. API Error: 401 OAuth access token is invalid.","stop_reason":"stop_sequence","session_id":"00000000-0000-0000-0000-000000000001","total_cost_usd":0}
JSON
    exit 1
fi
cat "${FAKE_CLAUDE_BODY:-$(dirname "$0")/recorded/claude-code-question.jsonl}"
