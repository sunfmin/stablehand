#!/bin/sh
# A stand-in of sesame (truefit.toml [[standin]] "sesame"): the calls
# stablehand makes, `provider show|add`, `login --token|--token-stdin` and
# `token --json`, kept in $SESAME_CONFIG_DIR/fake. With $FAKE_ARGV_LOG set,
# each call's argv is appended to it, one line. FAKE_SESAME_FAULT=token-refused:
# `login` refuses the token, as sesame refuses an empty one or one with a space;
# add-refused: `provider add` refuses the definition, as sesame a bad host.
dir="${SESAME_CONFIG_DIR:?}/fake"
mkdir -p "$dir/providers" "$dir/tokens"
[ -n "$FAKE_ARGV_LOG" ] && echo "sesame $*" >>"$FAKE_ARGV_LOG"
unknown() { echo "sesame: unknown provider \`$1\`" >&2; exit 1; }
case "$1 $2" in
"provider show")
    [ -f "$dir/providers/$3" ] || unknown "$3"
    echo '{}' ;;
"provider add")
    name=$3; shift 3
    if [ "$FAKE_SESAME_FAULT" = add-refused ] || [ -f "$dir/providers/$name" ]; then
        echo "sesame: provider \`$name\` exists" >&2; exit 1
    fi
    for f in --auth-url --token-url --api-base --host; do
        case " $* " in *" $f "*) ;; *) echo "sesame: $f is required" >&2; exit 2 ;; esac
    done
    echo "$*" >"$dir/providers/$name"
    echo "Added the provider \`$name\`" >&2 ;;
"login "*)
    [ -f "$dir/providers/$2" ] || unknown "$2"
    IFS= read -r token
    case "$FAKE_SESAME_FAULT:$token" in
    token-refused:* | *" "* | :)
        echo "sesame: the pasted token is empty or contains spaces" >&2; exit 1 ;;
    esac
    printf '%s' "$token" >"$dir/tokens/$2"
    echo "Stored the pasted \`$2\` token (pasted token)." >&2 ;;
"token "*)
    [ -f "$dir/providers/$2" ] || unknown "$2"
    if [ ! -f "$dir/tokens/$2" ]; then
        echo "sesame: no OAuth client for \`$2\`" >&2; exit 1
    fi
    printf '{"access_token":"%s","expires_at":null}\n' "$(cat "$dir/tokens/$2")" ;;
"--version "*) echo "sesame 0.1.21 (stand-in)" ;;
*) echo "fake-sesame: no stand-in for \`$*\`" >&2; exit 2 ;;
esac
