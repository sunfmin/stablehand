#!/bin/sh
# kimi-usages-shape <kimi-fake-curl|kimi-real-curl> <args>...: runs that
# curl, beside this script (the stand-in or the real one), as stablehand
# does, its headers on stdin, and prints what kimi's reader reads of the
# answer (src/readers/kimi.rs, src/curl.rs), and no more: curl's exit, the
# HTTP status, and, of a 200, the windows' shape; of any other, the error's
# type and whether it says a message.
program="$(dirname "$0")/$1"
shift
if [ ! -x "$program" ]; then
    echo "kimi-usages-shape: no $program" >&2
    exit 2
fi
out=$("$program" "$@" 2>/dev/null)
code=$?
echo "exit $code"
[ "$code" = 0 ] || exit 0
status=$(printf '%s' "$out" | tail -n 1)
body=$(printf '%s' "$out" | sed '$d')
echo "status $status"
if [ "$status" = 200 ]; then
    printf '%s' "$body" | jq -r '
        def ratio: if type == "number" or (type == "string" and test("^[0-9.]+$")) then "ratio" else type end;
        def kind: if type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T") then "time" else type end;
        def window: "used_ratio \(.used_ratio | ratio), reset_time \(.reset_time | kind)";
        "limit_5h: \(.usages.limit_5h | window)",
        "every window: \([.usages | to_entries[] | .value | objects | window]
            | all(. == "used_ratio ratio, reset_time time"))"'
else
    printf '%s' "$body" | jq -r '
        "error.type \(.error.type)",
        "error.message \(.error.message | type)"'
fi
