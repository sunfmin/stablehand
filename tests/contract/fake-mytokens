#!/bin/sh
# A stand-in of mytokens (truefit.toml [[standin]] "mytokens"): the calls
# stablehand makes, `list` and `get <service> --account <label> --field <F>`,
# read from $FAKE_MYTOKENS_DIR (default: mytokens-store beside it), one file
# per field, <service>/<label>/<FIELD>. With $FAKE_ARGV_LOG set, each call's
# argv is appended to it, one line. FAKE_MYTOKENS_FAULT=get-fails: every `get`
# fails, as mytokens does reading a field the entry lacks.
dir="${FAKE_MYTOKENS_DIR:-$(dirname "$0")/mytokens-store}"
[ -n "$FAKE_ARGV_LOG" ] && echo "mytokens $*" >>"$FAKE_ARGV_LOG"
case "$1" in
list)
    for entry in "$dir"/*/*; do
        [ -d "$entry" ] || continue
        fields=$(ls "$entry" | paste -sd, - | sed 's/,/, /g')
        printf '%s/%s\tprofile\tserver  — a stand-in entry  fields: %s\n' \
            "$(basename "$(dirname "$entry")")" "$(basename "$entry")" "$fields"
    done ;;
get)
    [ "$3 $5" = "--account --field" ] || { echo "fake-mytokens: no stand-in for \`$*\`" >&2; exit 2; }
    file="$dir/$2/$4/$6"
    if [ "$FAKE_MYTOKENS_FAULT" = get-fails ] || [ ! -f "$file" ]; then
        echo "$2/$4 has no field '$6'" >&2; exit 1
    fi
    cat "$file" ;;
*) echo "fake-mytokens: no stand-in for \`$*\`" >&2; exit 2 ;;
esac
