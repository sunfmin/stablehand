#!/bin/sh
# organization-shape <fake-curl|real-curl> <args>...: runs that curl, beside
# this script (the stand-in or the real one), as stablehand asks a token's
# organization (src/readers/claude_code.rs `organization`, src/curl.rs
# `post_for_header`), its headers on stdin, and prints what stablehand reads
# of the answer, and no more: curl's exit, the HTTP status, and whether the
# anthropic-organization-id it printed is an organization id, never the id.
program="$(dirname "$0")/$1"
shift
if [ ! -x "$program" ]; then
    echo "organization-shape: no $program" >&2
    exit 2
fi
out=$("$program" "$@" 2>/dev/null)
code=$?
echo "exit $code"
[ "$code" = 0 ] || exit 0
echo "status $(printf '%s' "$out" | tail -n 1)"
org=$(printf '%s' "$out" | tail -n 2 | head -n 1)
if printf '%s' "$org" | grep -Eq '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'; then
    echo "anthropic-organization-id: an organization id"
elif [ -z "$org" ]; then
    echo "anthropic-organization-id: none"
else
    echo "anthropic-organization-id: something else"
fi
