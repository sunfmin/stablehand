#!/bin/sh
# Runs a contract case of sesame on the program $1, in a store of the case's
# own ($PWD/cfg): each line of stdin is one call's arguments, run in order.
# A line `<text| args` gives the call <text> on stdin; `? args` prints its
# exit code alone, for a call whose stdout stablehand does not read.
export SESAME_CONFIG_DIR="$PWD/cfg"
unset SESAME_1PASSWORD_VAULT
prog=$1
# A stand-in's path is the repo's: from the repo's root, as truefit.toml names it.
case "$prog" in */*) prog="$(cd "$(dirname "$0")/../.." && pwd)/$prog" ;; esac
while IFS= read -r line; do
    input=; quiet=
    case "$line" in
    "<"*"| "*) input=${line%%| *}; input=${input#<}; line=${line#*| } ;;
    "? "*) quiet=1; line=${line#? } ;;
    esac
    eval "set -- $line"
    out=$(printf '%s\n' "$input" | "$prog" "$@" 2>/dev/null)
    code=$?
    echo "\$ $line -> exit $code"
    [ -z "$quiet" ] && [ -n "$out" ] && echo "$out"
done
