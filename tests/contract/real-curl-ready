#!/bin/sh
# Ready for `truefit contract --real claude-code`: a Claude Code login in
# ~/.claude/.credentials.json, and curl with the setup token's profile
# (setup-token-ready, see real-curl).
jq -e '.claudeAiOauth.accessToken' "$HOME/.claude/.credentials.json" >/dev/null 2>&1 &&
    "$(dirname "$0")/setup-token-ready" curl
