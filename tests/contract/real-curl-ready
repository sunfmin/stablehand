#!/bin/sh
# Ready for `truefit contract --real claude-code`: curl and jq on PATH, a
# Claude Code login in ~/.claude/.credentials.json, and the mytokens profile
# of a `claude setup-token` token (see real-curl).
command -v curl >/dev/null && command -v jq >/dev/null && command -v mytokens >/dev/null &&
    jq -e '.claudeAiOauth.accessToken' "$HOME/.claude/.credentials.json" >/dev/null 2>&1 &&
    mytokens list 2>/dev/null | grep -q "^${STABLEHAND_CONTRACT_SETUP_TOKEN:-claude-theplant-jp}/"
