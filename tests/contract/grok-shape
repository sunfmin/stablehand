#!/bin/sh
# grok-shape <fake-curl|real-grok-curl> <args>...: runs that curl, beside
# this script, as stablehand does, its headers on stdin, and prints what
# stablehand reads of the answer (src/readers/grok.rs, src/curl.rs), and no
# more: curl's exit, the HTTP status, and, of a 200, the credit period's and
# the products' shape; of any other, the error's. The answer is proto3's
# JSON, which leaves out a 0 and an empty list, as a period just begun does:
# an absent creditUsagePercent is read as the number 0, and an absent
# productUsage as no products.
program="$(dirname "$0")/$1"
shift
if [ ! -x "$program" ]; then
    echo "grok-shape: no $program" >&2
    exit 2
fi
out=$("$program" "$@" 2>/dev/null)
code=$?
echo "exit $code"
[ "$code" = 0 ] || exit 0
status=$(printf '%s' "$out" | tail -n 1)
body=$(printf '%s' "$out" | sed '$d')
echo "status $status"
if [ "$status" = 200 ]; then
    printf '%s' "$body" | jq -r '
        def kind: if type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T") then "time" else type end;
        .config as $c | $c.currentPeriod as $p
        | ($c.productUsage // []) as $products
        | "currentPeriod.type \($p.type | type)",
          "currentPeriod.start \($p.start | kind), end \($p.end | kind)",
          "creditUsagePercent \($c.creditUsagePercent // 0 | type)",
          "productUsage \($products | type)",
          "every product: \([$products[] | "product \(.product | type), usagePercent \(.usagePercent | type)"]
            | all(. == "product string, usagePercent number"))"'
else
    printf '%s' "$body" | jq -r '"error \(.error | type)"'
fi
