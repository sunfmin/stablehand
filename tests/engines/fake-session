#!/bin/sh
# A stand-in of an engine's session (claude, codex, agy, …), linked under the
# engine's program: appends to $FAKE_ARGV_LOG one line, its argv, the home
# variables it was given and STABLEHAND_ACCOUNT, its token variable's sha256 (never the token), and
# where its home's login file links to; writes its pid to $FAKE_PID_FILE when
# set, and sends its parent the signal $FAKE_SIGNAL_PARENT names when set.
# Then waits until $FAKE_HOLD names no file (or holds there, killed), and
# exits $FAKE_EXIT (default 0).
line="$(basename "$0") $*"
for v in CLAUDE_CONFIG_DIR CODEX_HOME KIMI_CODE_HOME GROK_HOME PI_CODING_AGENT_DIR DSH_HOME HOME STABLEHAND_ACCOUNT; do
    eval "x=\${$v:-}"
    [ -n "$x" ] && line="$line $v=$x"
done
if [ -n "${CLAUDE_CODE_OAUTH_TOKEN+set}" ]; then
    line="$line token_sha=$(printf '%s' "$CLAUDE_CODE_OAUTH_TOKEN" | shasum -a 256 | cut -c1-64)"
fi
if [ -n "$FAKE_LOGIN_FILE" ]; then
    line="$line login->$(readlink "$FAKE_LOGIN_FILE")"
fi
echo "$line" >>"${FAKE_ARGV_LOG:?}"
[ -n "$FAKE_PID_FILE" ] && echo $$ >"$FAKE_PID_FILE"
if [ -n "$FAKE_SIGNAL_PARENT" ]; then
    kill -"$FAKE_SIGNAL_PARENT" "$PPID"
    sleep 0.3
fi
echo "session on stdout"
while [ -n "$FAKE_HOLD" ] && [ -e "$FAKE_HOLD" ]; do sleep 0.05; done
exit "${FAKE_EXIT:-0}"
